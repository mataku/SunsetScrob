{
  extends: [
    'config:recommended',
  ],
  minimumReleaseAge: '7 days',
  ignoreDeps: [
    'com.jakewharton.timber:timber',
    'org.junit.vintage:junit-vintage-engine',
  ],
  prConcurrentLimit: 3,
  rebaseWhen: 'conflicted',
  packageRules: [
    {
      matchUpdateTypes: [
        'major',
        'patch',
        'minor',
      ],
      groupName: 'GitHubActions',
      matchManagers: [
        'github-actions',
      ],
      automerge: true,
      platformAutomerge: true,
      timezone: 'Asia/Tokyo',
      schedule: [
        '* 13-19 * * 5',
      ],
    },
    {
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      automerge: true,
      platformAutomerge: true,
    },
    {
      groupName: 'gradle-libraries',
      matchManagers: [
        'gradle',
        'gradle-wrapper',
      ],
      timezone: 'Asia/Tokyo',
      schedule: [
        '* 12-17 * * 6',
      ],
    },
    {
      groupName: 'compose_compiler_kotlin',
      matchPackageNames: [
        'org.jetbrains.kotlin.{/,}**',
        'com.google.devtools.ksp{/,}**',
      ],
    },
    {
      groupName: 'ruby',
      matchManagers: [
        'ruby-version',
        'github-actions',
      ],
      timezone: 'Asia/Tokyo',
      schedule: [
        '* 13-19 * * 5',
      ],
      matchPackageNames: [
        '/^ruby$/',
        '/^ruby/setup-ruby$/',
      ],
    }, {
      groupName: 'ruby',
      matchManagers: [
        'bundler',
      ],
      timezone: 'Asia/Tokyo',
      schedule: [
        '* 13-19 * * 5',
      ],
    },
  ],
}
