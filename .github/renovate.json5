{
  extends: [
    'config:recommended',
  ],
  minimumReleaseAge: '7 days',
  ignoreDeps: [
    'com.jakewharton.timber:timber',
    'org.junit.vintage:junit-vintage-engine',
  ],
  prConcurrentLimit: 3,
  rebaseWhen: 'conflicted',
  hostRules: [
    {
      // Maven Central rate-limits by source IP and the Mend runners share theirs.
      // Renovate defaults to 16 concurrent requests with no throttle for this host,
      // and gives up when Retry-After exceeds 60s, which aborts the whole run.
      matchHost: 'repo.maven.apache.org',
      concurrentRequestLimit: 4,
      maxRequestsPerSecond: 4,
      maxRetryAfter: 180,
    },
  ],
  packageRules: [
    {
      matchUpdateTypes: [
        'major',
        'patch',
        'minor',
      ],
      groupName: 'GitHubActions',
      matchManagers: [
        'github-actions',
      ],
      automerge: true,
      platformAutomerge: true,
      timezone: 'Asia/Tokyo',
      schedule: [
        '* 13-19 * * 5',
      ],
    },
    {
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      automerge: true,
      platformAutomerge: true,
    },
    {
      groupName: 'gradle-libraries',
      matchManagers: [
        'gradle',
        'gradle-wrapper',
      ],
      timezone: 'Asia/Tokyo',
      schedule: [
        '* 12-17 * * 6',
      ],
    },
    {
      groupName: 'compose_compiler_kotlin',
      matchPackageNames: [
        'org.jetbrains.kotlin{.,:}**',
      ],
    },
    {
      groupName: 'compose-multiplatform',
      matchPackageNames: [
        'org.jetbrains.compose{/,}**',
        'org.jetbrains.androidx.{/,}**',
        'androidx.compose{/,}**',
        'androidx.navigation3{/,}**',
      ],
    },
    {
      groupName: 'ruby',
      matchManagers: [
        'ruby-version',
        'github-actions',
      ],
      timezone: 'Asia/Tokyo',
      schedule: [
        '* 13-19 * * 5',
      ],
      matchPackageNames: [
        '/^ruby$/',
        '/^ruby/setup-ruby$/',
      ],
    }, {
      groupName: 'ruby',
      matchManagers: [
        'bundler',
      ],
      timezone: 'Asia/Tokyo',
      schedule: [
        '* 13-19 * * 5',
      ],
    },
  ],
}
