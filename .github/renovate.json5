{
  extends: [
    'config:recommended',
  ],
  minimumReleaseAge: '7 days',
  ignoreDeps: [
    'com.jakewharton.timber:timber',
    'org.junit.vintage:junit-vintage-engine',
  ],
  prConcurrentLimit: 3,
  rebaseWhen: 'conflicted',
  // Unit, screenshot, lint and architecture tests gate every PR, so all updates (major included) automerge once CI is green.
  automerge: true,
  platformAutomerge: true,
  hostRules: [
    {
      // Maven Central rate-limits by source IP and the Mend runners share theirs.
      // Renovate defaults to 16 concurrent requests with no throttle for this host,
      // and gives up when Retry-After exceeds 60s, which aborts the whole run.
      matchHost: 'repo.maven.apache.org',
      concurrentRequestLimit: 4,
      maxRequestsPerSecond: 4,
      maxRetryAfter: 180,
    },
  ],
  packageRules: [
    {
      matchUpdateTypes: [
        'major',
        'patch',
        'minor',
      ],
      groupName: 'GitHubActions',
      matchManagers: [
        'github-actions',
      ],
      timezone: 'Asia/Tokyo',
      schedule: [
        '* 13-19 * * 5',
      ],
    },
    {
      groupName: 'gradle-libraries',
      // A constant title makes Renovate match a previously merged PR and disable automerge,
      // so append the newest release date. Renovate drops this when the group spans several versions.
      commitMessageExtra: '{{#if releaseTimestamp}}({{lookup (split releaseTimestamp "T") 0}}){{/if}}',
      matchManagers: [
        'gradle',
        'gradle-wrapper',
      ],
      timezone: 'Asia/Tokyo',
      schedule: [
        '* 12-17 * * 6',
      ],
    },
    {
      groupName: 'compose_compiler_kotlin',
      matchPackageNames: [
        'org.jetbrains.kotlin{.,:}**',
      ],
    },
    {
      groupName: 'compose-multiplatform',
      matchPackageNames: [
        'org.jetbrains.compose{/,}**',
        'org.jetbrains.androidx.{/,}**',
        'androidx.compose{/,}**',
        'androidx.navigation3{/,}**',
      ],
    },
    {
      groupName: 'ruby',
      matchManagers: [
        'ruby-version',
        'github-actions',
      ],
      timezone: 'Asia/Tokyo',
      schedule: [
        '* 13-19 * * 5',
      ],
      matchPackageNames: [
        '/^ruby$/',
        '/^ruby/setup-ruby$/',
      ],
    }, {
      groupName: 'ruby',
      matchManagers: [
        'bundler',
      ],
      timezone: 'Asia/Tokyo',
      schedule: [
        '* 13-19 * * 5',
      ],
    },
    {
      matchManagers: [
        'gradle',
      ],
      minimumReleaseAge: null,
    },
  ],
}
